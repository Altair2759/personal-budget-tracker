<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
        <h1>
            Add Transaction
        </h1>

<form action="/transaction/add" method="POST">

    <label>Category</label>
    <select name="categoryId" required>
        <% categories.forEach(category => { %>
            <option value="<%= category._id %>">
                <%= category.name %>
            </option>
        <% }) %>
    </select>

    <label>Type</label>
    <input
        type="text"
        name="type"
        required
    >

    <label>Amount</label>
    <input
        type="number"
        name="amount"
        required
    >

    <label>Note</label>
    <input
        type="text"
        name="note"
    >

    <button type="submit">
        Add Transaction
    </button>

</form>

        
</body>
</html>
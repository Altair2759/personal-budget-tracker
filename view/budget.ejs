<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <title>BudgetTracker</title>
</head>
<body>
    <aside class="sidebar">
        <div class="logo">
            <h1>BudgetTracker</h1>
        </div>

        <nav class="navbar">
            <a href="/dashboard">Dashboard</a>
            <a href="/transactions">Transaction</a>
            <a href="/category">Category</a>
            <a href="/budget" class="<%= currentPage === 'budget' ? 'active' : '' %>">Budgets</a>
            <a>Reports</a>
        </nav>
    </aside>

    <main class="dashboard">
        <header class="dash-header">
            <h1>Budgets</h1>
        </header>

        <section class="sum-cards">
            <div class="card">
                <h3>Total Budget</h3>
                <p><%= formatCurrency(totalBudget.toFixed(2)) %></p>
            </div>
            <div class="card">
                <h3>Total Spent</h3>
                <p><%= formatCurrency(totalBudgetSpent.toFixed(2)) %></p>
            </div>
            <div class="card">
                <h3>Remaining</h3>
                <p><%= formatCurrency(remaining.toFixed(2)) %></p>
            </div>
        </section>

         <section class="Transaction-filters">
            <div class="filter-card"></div>
            <div class="filter-card">
                <search>
                    <form action="/search" method="get">
                        <input type="search" id="transaction-search" name="q" placeholder="Search" />
                        <button type="submit" class="search-btn">Search</button>
                    </form>
                </search>
            </div>
            <div class="filter-card">
                <a class="add-btn" href="/budget/add">+ Budget</a>
            </div>
        </section>
        
        <section class="budget-columns">
            <% budgets.forEach(budget => { %> 
                <div class="budget-card">
                    <div class="budget-card-header">
                        <h3><%= budget.categoryId.name %></h3>
                        <span>
                            <%= new Date(2000, budget.month -1).toLocaleString('en-ZA', { month: 'long' }) %> 
                            <%= budget.year %>
                        </span>
                    </div>

                    <div class="budget-amounts">
                        <div>
                            <span>Budget</span>
                            <p><%= formatCurrency(budget.amount) %></p>
                        </div>
                        <div>
                            <span>Spent</span>
                            <p><%= formatCurrency(budget.totalSpent) %></p>
                        </div>
                    </div>
                    
                    
                    <div class="budget-progress">
                        <progress value="<%= budget.totalSpent %>" max="<%= budget.amount %>"></progress>
                    </div>
                    
                    <p class="budget-remaining">
                        Remaining: <%= formatCurrency(budget.amount - budget.totalSpent) %>
                    </p>
                </div>
            <%}) %>
            
        </section>
    </main>

    
</body>
</html>
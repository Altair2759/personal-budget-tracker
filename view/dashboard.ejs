<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <title>BudgetTracker</title>
</head>
<body>
    <aside class="sidebar">
        <div class="logo">
            <h1>BudgetTracker</h1>
        </div>

        <nav class="navbar">
            <a href="/dashboard" class="<%= currentPage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
            <a href="/transactions">Transaction</a>
            <a href="/category">Category</a>
            <a href="/budget">Budgets</a>
            <a>Reports</a>
        </nav>
    </aside>

    <main class="dashboard">
        <header class="dash-header">
            <h1>Dashboard</h1>
        </header>

        <section class="sum-cards">
            <div class="card">
                <h3>Total Balance</h3>
                <p>R 0.00</p>
            </div>
            <div class="card">
                <h3>Monthly Income</h3>
                <p>R 0.00</p>
            </div>
            <div class="card">
                <h3>Monhtly Expense</h3>
                <p>R 0.00</p>
            </div>
            <div class="card">
                <h3>Remaining Budget</h3>
                <p>R 0.00</p>
            </div>
        </section>

        <section class="dash-charts">
            <div class="chart-container">
                <h3>Income vs Expenses</h3>
                <!-- <canvas id="incomeExpenseChart"></canvas> -->
                <canvas id="myChart"></canvas>
            </div>
            <div class="chart-container">
                <h3>Expense Distribution</h3>
                <canvas id="expenseChart"></canvas>
            </div>
        </section>
    </main>

    
</body>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/chart.js"></script>

</html>